{
  "info": {
    "name": "library-management-system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"LIBRARIAN\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('token', pm.response.json().access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Create Genre",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Fantasy\"\n}" },
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Get All Genres",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/genres" }
        },
        {
          "name": "Get Genre By Id",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/genres/1" }
        },
        {
          "name": "Update Genre",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Science Fiction\"\n}" },
            "url": "{{baseUrl}}/genres/1"
          }
        },
        {
          "name": "Delete Genre",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/genres/1" }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get Books (filter, search, paginate)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books?genreId=1&search=dune&page=1&limit=10"
          }
        },
        {
          "name": "Get Book By Id",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/books/1" }
        },
        {
          "name": "Create Book",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dune\",\n  \"author\": \"Frank Herbert\",\n  \"isbn\": \"9780441172719\",\n  \"totalCopies\": 3,\n  \"genreId\": 1\n}"
            },
            "url": "{{baseUrl}}/books"
          }
        },
        {
          "name": "Update Book",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"totalCopies\": 5\n}" },
            "url": "{{baseUrl}}/books/1"
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/books/1"
          }
        }
      ]
    }
  ]
}
